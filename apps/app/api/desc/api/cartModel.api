syntax = "v1"

import "basicModel.api"


type (
    // ------------添加商品到购物车------------
    AddToCartReq{
        ProductID int64 `json:"product_id"` // 商品ID
        Quantity  int64 `json:"quantity,default:1"`   // 商品数量
    }

    AddToCartResp{
        Success bool `json:"success"` // 是否添加成功
    }

    // ------------获取购物车商品列表------------
    CartListResp{
        Items []*CartItem `json:"items"` // 购物车商品列表
    }

    // ------------更新购物车商品数量------------
    UpdateCartReq{
        CartItemID int64 `json:"cart_item_id"` // 购物车项ID
        Quantity   int64 `json:"quantity"`     // 新的商品数量
    }

    UpdateCartResp{
        Success bool `json:"success"` // 是否更新成功
    }

    // ------------删除购物车商品------------
    DeleteCartReq{
        CartItemID int64 `json:"cart_item_id"` // 购物车项ID
    }

    DeleteCartResp{
        Success bool `json:"success"` // 是否删除成功
    }
)